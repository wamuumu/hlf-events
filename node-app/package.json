{
    "name": "resource-events-app",
    "version": "1.0.0",
    "description": "Resource Events Application implemented in typeScript using fabric-gateway",
    "main": "dist/index.js",
    "typings": "dist/index.d.ts",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc -w",
        "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/app.ts",
        "lint": "eslint src",
        "prepare": "npm run build",
        "pretest": "npm run lint",
        "start": "node dist/app.js"
    },
    "engineStrict": true,
    "author": "Matteo Costalonga",
    "license": "Apache-2.0",
    "dependencies": {
        "@grpc/grpc-js": "^1.12.2",
        "@hyperledger/fabric-gateway": "^1.7.0",
        "dotenv": "^17.2.0",
        "express": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.3.0",
        "@tsconfig/node18": "^18.2.2",
        "@types/express": "^5.0.5",
        "@types/node": "^18.19.130",
        "eslint": "^8.57.1",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "typescript": "~5.4",
        "typescript-eslint": "^7.13.0"
    }
}
